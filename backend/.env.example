# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq — get from console.groq.com (free tier available)
GROQ_API_KEY=gsk_your-groq-key-here

# Hugging Face — get from huggingface.co/settings/tokens (free tier available)
HUGGINGFACE_API_KEY=hf_your-hf-key-here

# Replicate — get from replicate.com/account/api-tokens (free tier available)
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# CORS — comma-separated list of allowed frontend origins
# In dev this is your Next.js dev server; in prod it's your Vercel URL
ALLOWED_ORIGINS=http://localhost:3000

# Environment
ENVIRONMENT=development

# Dev user ID — used in place of real auth during development (Spec 01–07)
# Replace with a real UUID, any UUID will do
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Auth is strict by default. Set to false ONLY for local development: it is
# ignored unless ENVIRONMENT=development, so it cannot weaken production.
AUTH_REQUIRED=true
