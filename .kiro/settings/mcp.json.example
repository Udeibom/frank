{
  "_note": "Copy to .kiro/settings/mcp.json and fill in the <placeholders>. The real file is git-ignored because it holds a token. Servers: context7 (current library docs), supabase (database advisors and checks), playwright (drives a real browser to test the studio screens), frank-listener (Frank's own Listener, so Kiro can hear its renders; set up with: python3 -m venv tools/listener_mcp/.venv && tools/listener_mcp/.venv/bin/pip install -r tools/listener_mcp/requirements.txt).",
  "mcpServers": {
    "context7": {
      "command": "node",
      "args": [
        "<path-to-global-node-modules>/@upstash/context7-mcp/dist/index.js"
      ],
      "disabled": false,
      "autoApprove": [
        "resolve-library-id",
        "get-library-docs"
      ]
    },
    "supabase": {
      "command": "node",
      "args": [
        "<path-to-global-node-modules>/@supabase/mcp-server-supabase/dist/cli.js",
        "--read-only",
        "--project-ref=<your-supabase-project-ref>"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "<set-me>"
      },
      "disabled": false,
      "autoApprove": [
        "list_tables",
        "list_extensions",
        "list_migrations",
        "execute_sql"
      ]
    },
    "playwright": {
      "command": "node",
      "args": [
        "<path-to-global-node-modules>/@playwright/mcp/cli.js"
      ],
      "disabled": false,
      "autoApprove": [
        "browser_navigate",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_take_screenshot"
      ]
    },
    "frank-listener": {
      "command": "<repo>/tools/listener_mcp/.venv/bin/python",
      "args": [
        "<repo>/tools/listener_mcp/server.py"
      ],
      "disabled": false,
      "autoApprove": [
        "measure_file",
        "find_issues_file",
        "compare_files"
      ]
    }
  }
}
